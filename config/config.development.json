{
  "environment": "development",
  "service": {
    "name": "storvia-api",
    "release": "dev"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "read_header_timeout": "10s",
    "read_timeout": "60s",
    "write_timeout": "0s",
    "idle_timeout": "120s",
    "upload_timeout": "30m",
    "shutdown_grace": "30s"
  },
  "logging": {
    "level": "debug",
    "format": "json"
  },
  "database": {
    "driver": "sqlite",
    "sqlite_path": "file:./storvia.dev.db",
    "max_open_conns": 1,
    "max_idle_conns": 1,
    "conn_max_lifetime": "30m",
    "conn_max_idle_time": "5m",
    "auto_migrate": true
  },
  "cache": {
    "driver": "memory",
    "redis_address": "",
    "redis_database": 0,
    "janitor_interval": "1m",
    "redis_password_ref": "STORVIA_REDIS_PASSWORD"
  },
  "auth": {
    "session_signing_key_ref": "STORVIA_SESSION_SIGNING_KEY",
    "session_cookie_name": "storvia_session",
    "session_ttl": "12h",
    "secure_cookie": false
  },
  "admin_panel": {
    "enabled": true,
    "tenant_id": "tenant_dev_admin",
    "user_id": "user_dev_admin",
    "flow_cookie": "storvia_admin_flow",
    "simulate_drive_outage": true
  },
  "security": {
    "encryption_key_ref": "STORVIA_ENCRYPTION_KEY",
    "encryption_key_previous_ref": "",
    "allowed_origins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ],
    "allowed_endpoint_schemes": [
      "https"
    ],
    "allowed_endpoint_hosts": []
  },
  "uploads": {
    "max_file_size_bytes": 5368709120,
    "allowed_mime_types": [
      "application/pdf",
      "application/zip",
      "text/csv",
      "text/plain",
      "image/jpeg",
      "image/png"
    ],
    "allowed_categories": [
      "report",
      "document",
      "image"
    ],
    "drive_chunk_size_bytes": 8388608,
    "s3_part_size_bytes": 8388608,
    "min_part_size_bytes": 5242880,
    "presigned_url_ttl": "15m",
    "category_limits": {
      "image": 26214400
    }
  },
  "drive": {
    "client_id_ref": "STORVIA_GOOGLE_CLIENT_ID",
    "client_secret_ref": "STORVIA_GOOGLE_CLIENT_SECRET",
    "redirect_uri": "http://127.0.0.1:8080/v1/storage/connections/google-drive/callback",
    "admin_redirect_uri": "http://127.0.0.1:8080/admin/oauth/callback",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ],
    "root_folder_name": "Storvia",
    "preflight_timeout": "3s",
    "preflight_attempts": 2,
    "routing_budget": "8s",
    "circuit_failures": 2,
    "circuit_cooldown": "30s"
  },
  "fallback": {
    "enabled": true,
    "consent_required": false,
    "backends": [
      {
        "id": "r2-primary",
        "vendor": "cloudflare_r2",
        "endpoint": "https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com",
        "region": "auto",
        "bucket": "storvia-fallback",
        "prefix": "",
        "access_key_id_ref": "STORVIA_R2_ACCESS_KEY_ID",
        "secret_access_key_ref": "STORVIA_R2_SECRET_ACCESS_KEY",
        "session_token_ref": "STORVIA_R2_SESSION_TOKEN",
        "use_path_style": true,
        "disabled": false,
        "multipart_abort_ttl": "24h"
      }
    ]
  }
}
