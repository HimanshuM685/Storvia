{"nodes": [{"id": "readme_drive_first", "label": "Drive-first file storage", "file_type": "concept", "source_file": "README.md", "source_location": "lines 1-7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The product promise is to store files in the user's Drive and use one configured S3-compatible bucket only when Drive is unavailable."}, {"id": "readme_single_location", "label": "Exactly one stored copy", "file_type": "concept", "source_file": "README.md", "source_location": "lines 3-7 and 47-60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No mirroring, dual-write, or copy-back is allowed because a temporary second location would violate the single-location invariant."}, {"id": "readme_upload_routing", "label": "Pre-write upload routing", "file_type": "concept", "source_file": "README.md", "source_location": "lines 17-45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only bounded read-only preflight transport failure before bytes leave the process can select fallback; quota, auth, policy, missing-folder, and unknown failures are not outage evidence."}, {"id": "readme_drive_resumable_session", "label": "Drive resumable session mode", "file_type": "concept", "source_file": "README.md", "source_location": "lines 458-486", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drive receives chunks directly through a one-file session capability; the session is returned once and not persisted, and the reported file ID is revalidated before adoption."}, {"id": "readme_s3_presigned_parts", "label": "S3 presigned parts mode", "file_type": "concept", "source_file": "README.md", "source_location": "lines 458-482", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fallback uploads use short-lived operation-scoped capabilities and keep file bytes out of the Storvia API in the same way as the Drive session path."}, {"id": "readme_oauth_backend", "label": "Backend-owned OAuth flow", "file_type": "concept", "source_file": "README.md", "source_location": "lines 122-143 and 331-371", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The frontend is only a client: Go starts consent, verifies state, exchanges the code, issues the session, and keeps tokens and authorization codes out of the browser."}, {"id": "readme_configuration_boundary", "label": "JSON and environment secrecy split", "file_type": "concept", "source_file": "README.md", "source_location": "lines 246-305", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordinary settings remain reviewable in JSON while credentials and deployment-specific secret values stay in ignored runtime environment injection."}, {"id": "readme_tenant_isolation", "label": "Structural tenant isolation", "file_type": "concept", "source_file": "README.md", "source_location": "lines 487-505", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified tenant scope is required for repositories and cross-tenant reads return not-found so identifiers cannot become an existence oracle."}, {"id": "readme_rfc9457_errors", "label": "RFC 9457 problem details", "file_type": "concept", "source_file": "README.md", "source_location": "lines 418-420", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One standard problem format gives both SDKs and API consumers one machine-readable failure parser."}], "edges": [{"source": "readme_drive_first", "target": "docs_storage_policy_drive_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "lines 1-7", "weight": 1.0}, {"source": "readme_single_location", "target": "docs_storage_policy_single_copy", "relation": "referen