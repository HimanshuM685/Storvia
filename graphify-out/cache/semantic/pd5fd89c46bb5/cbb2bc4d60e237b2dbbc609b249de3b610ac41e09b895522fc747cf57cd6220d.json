{"nodes": [{"id": "docs_storage_policy_drive_first", "label": "Drive-first confirmed contract", "file_type": "concept", "source_file": "docs/storage-policy.md", "source_location": "lines 1-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal uploads use the user's Drive, while one configured S3-compatible backend is reserved for Drive unavailability and the implementation remains in Go."}, {"id": "docs_storage_policy_outage_classification", "label": "Outage-only fallback classification", "file_type": "concept", "source_file": "docs/storage-policy.md", "source_location": "lines 18-36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fallback is allowed only for bounded pre-mutation transport or eligible 5xx preflight failures; quota, auth, policy, and unknown errors are not fallback triggers."}, {"id": "docs_storage_policy_single_copy", "label": "Single-copy invariant", "file_type": "concept", "source_file": "docs/storage-policy.md", "source_location": "lines 38-47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The selected provider is persisted before mutation and remains authoritative after mutation may start, preventing dual-write and hidden payload spooling."}, {"id": "docs_storage_policy_ambiguous_write", "label": "Same-provider ambiguous write handling", "file_type": "concept", "source_file": "docs/storage-policy.md", "source_location": "lines 49-59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outcome unknown is reconciled on the original provider; a fresh attempt is permitted only after terminal evidence and confirmed cleanup."}, {"id": "docs_storage_policy_stay_in_place", "label": "Fallback stay-in-place rule", "file_type": "concept", "source_file": "docs/storage-policy.md", "source_location": "lines 61-69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An object written to fallback remains there after Drive recovers; new uploads return to Drive and no automatic move-back is performed."}, {"id": "docs_storage_policy_circuit_breaker", "label": "Scoped Drive circuit breaker", "file_type": "concept", "source_file": "docs/storage-policy.md", "source_location": "lines 71-80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The circuit is scoped to connection and egress context, uses bounded probes and cooldown, and cannot cascade writes across fallback providers."}, {"id": "docs_storage_policy_consent", "label": "Tenant fallback consent gate", "file_type": "concept", "source_file": "docs/storage-policy.md", "source_location": "lines 82-88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The destination, region, access, retention, cost, and deletion consequences must be disclosed before enabling outage uploads outside the user's Drive."}], "edges": [{"source": "docs_storage_policy_drive_first", "target": "docs_storage_policy_outage_classification", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/storage-policy.md", "source_location": "lines 9-36", "weight": 1.0}, {"source": "docs_storage_policy_outage_classification", "target": "docs_storage_policy_ambiguous_write", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/storage-policy.md", "source_location": "lines 22-36", "weight": 1.0}, {"source": "docs_storage_policy_single_copy", "target": "docs_storage_policy_stay_in_place", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/storage-policy.md", "source_location": "lines 38-47 and 61-69", "weight": 1.0}, {"source": "docs_storage_policy_circuit_breaker", "target": "docs_storage_policy_outage_classification", "relation": "references", "confidence":