# Storvia environment template — DEVELOPMENT
#
# Copy to .env.development and fill in real values:
#
#   cp .env.example .env.development
#
# .env.development MUST be gitignored. It is listed in .gitignore; if you ever see
# it staged, something is wrong.
#
# Every value here is referenced from config/config.development.json by a
# ${VARIABLE_NAME} placeholder. A placeholder with no value and no default is a
# startup error, so a missing key fails loudly instead of becoming an empty
# credential.
#
# Comment lines start with #. Values may be quoted; single quotes keep a value
# completely literal, which is the safe choice for secrets containing \ or $.


# ---------------------------------------------------------------------------
# Required: application sessions
# ---------------------------------------------------------------------------

# HMAC key for signing session tokens. Must be at least 32 characters; the service
# refuses to start with anything shorter. Generate with:
#   openssl rand -base64 48
STORVIA_SESSION_SIGNING_KEY=replace-me-with-openssl-rand-base64-48-output


# ---------------------------------------------------------------------------
# Required: encryption key for stored Google refresh tokens
# ---------------------------------------------------------------------------

# AES-256 key, exactly 32 bytes, hex (64 chars) or base64. Generate with:
#   openssl rand -hex 32
# This key encrypts every Drive refresh token before it reaches the database.
# Losing it means every user must reconnect their Drive. Rotating it requires
# the *_PREVIOUS variable below so existing ciphertext stays readable.
STORVIA_ENCRYPTION_KEY=replace-with-64-hex-characters

# Optional: the outgoing key during a rotation. Set the new value in
# STORVIA_ENCRYPTION_KEY and the old one here until every row has been rewritten.
# STORVIA_ENCRYPTION_KEY_PREVIOUS=


# ---------------------------------------------------------------------------
# Required: Google OAuth client (drive.file scope only)
# ---------------------------------------------------------------------------
#
# From Google Cloud Console -> APIs & Services -> Credentials.
# The authorized redirect URI must match drive.redirect_uri in the JSON config
# exactly, including scheme, capitalization, and any trailing slash.

STORVIA_GOOGLE_CLIENT_ID=
STORVIA_GOOGLE_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# Required when database.driver is "postgres"
# ---------------------------------------------------------------------------
#
# Not needed for the SQLite development default.

# STORVIA_DATABASE_DSN=postgres://storvia:password@localhost:5432/storvia?sslmode=require


# ---------------------------------------------------------------------------
# Required when cache.driver is "redis"
# ---------------------------------------------------------------------------
#
# Not needed for the in-memory development default. Redis is only needed once the
# service runs more than one instance, so that OAuth tokens and Drive circuit
# state are shared across replicas.

# STORVIA_REDIS_ADDRESS=localhost:6379
# STORVIA_REDIS_PASSWORD=


# ---------------------------------------------------------------------------
# Optional: Cloudflare R2 fallback (outage-only, S3-compatible)
# ---------------------------------------------------------------------------
#
# Used ONLY when Drive is unavailable, and only for NEW uploads. Storvia keeps no
# second copy: a file uploaded here stays here, and an upload that reached Drive
# is never copied over.
#
# From Cloudflare dashboard -> R2 -> Manage R2 API Tokens.
# Keep this bucket private. Do not add a public bucket URL.

# R2 account endpoint host, the YOUR_ACCOUNT_ID part of
# https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# STORVIA_R2_ACCOUNT_ID=

STORVIA_R2_ACCESS_KEY_ID=
STORVIA_R2_SECRET_ACCESS_KEY=

# Only for temporary credentials. Leave empty for long-lived keys.
# STORVIA_R2_SESSION_TOKEN=


# ---------------------------------------------------------------------------
# Optional: AWS S3 fallback (outage-only, S3-compatible)
# ---------------------------------------------------------------------------
#
# Use this instead of the R2 values when AWS S3 is the chosen fallback. Both
# cannot be active at once: Storvia uses exactly one fallback backend per
# deployment, and does not cascade writes across providers.

# STORVIA_S3_ACCESS_KEY_ID=
# STORVIA_S3_SECRET_ACCESS_KEY=
# STORVIA_S3_SESSION_TOKEN=